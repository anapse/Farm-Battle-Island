rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    function validPlayerName(name) {
      return name is string && name.size() >= 2 && name.size() <= 32;
    }

    // Firestore is exclusively for durable leaderboard/statistics records.
    // Match state, character selections, shots, impacts, turns and presence
    // must never be written here.
    match /ranking/{playerId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && validId(playerId)
        && request.resource.data.keys().hasOnly([
          'playerName', 'score', 'matchesPlayed', 'victories', 'defeats'
        ])
        && validPlayerName(request.resource.data.playerName)
        && request.resource.data.score is number
        && request.resource.data.matchesPlayed is number
        && request.resource.data.victories is number
        && request.resource.data.defeats is number;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
