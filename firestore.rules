rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for data validation
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    function isValidPlayerName(name) {
      return name is string && name.size() >= 2 && name.size() <= 32;
    }

    // 1. Matches Collection
    match /matches/{matchId} {
      // Allow reading matches (lobby listing and game state sync)
      allow read: if true;

      // Allow creating new matches with waiting status
      allow create: if isValidId(matchId)
        && request.resource.data.status == 'waiting'
        && isValidPlayerName(request.resource.data.creatorPlayerName)
        && isValidId(request.resource.data.creatorPlayerId)
        && request.resource.data.player1.id == request.resource.data.creatorPlayerId
        && request.resource.data.player2 == null;

      // Allow updating matches with strict state transition logic
      allow update: if isValidId(matchId)
        // Protection: Once a match is finished, it CANNOT be modified again (Idempotency protection)
        && resource.data.status != 'finished'
        && (
          // Case A: Player 2 joins (waiting -> starting)
          (resource.data.status == 'waiting' 
           && request.resource.data.status == 'starting' 
           && request.resource.data.player2 != null
           && request.resource.data.player2.id != resource.data.player1.id)
          ||
          // Case B: Character selection (starting -> starting or starting -> playing)
          // ABSOLUTE RULE: Both players CANNOT pick the same character!
          (resource.data.status == 'starting'
           && (request.resource.data.player1.characterId == null 
               || request.resource.data.player2.characterId == null 
               || request.resource.data.player1.characterId != request.resource.data.player2.characterId))
          ||
          // Case C: Combat updates (playing -> playing)
          (resource.data.status == 'playing' && request.resource.data.status == 'playing')
          ||
          // Case D: Match completion or surrender (playing/starting -> finished)
          (request.resource.data.status == 'finished')
          ||
          // Case E: Match cancellation
          (request.resource.data.status == 'cancelled')
        );

      allow delete: if false;
    }

    // 2. Presence Collection (Heartbeat & Disconnect Detection)
    match /presence/{playerId} {
      allow read: if true;
      allow create, update: if isValidId(playerId)
        && request.resource.data.playerId == playerId
        && request.resource.data.lastSeenAt is number;
      allow delete: if false;
    }

    // 3. Ranking Collection (Top 50 Leaderboard)
    match /ranking/{playerId} {
      allow read: if true;
      allow create, update: if isValidId(playerId)
        && isValidPlayerName(request.resource.data.playerName)
        && request.resource.data.score is number
        && request.resource.data.victories is number
        && request.resource.data.defeats is number;
      allow delete: if false;
    }

    // 4. Global Stats (/admin Dashboard)
    match /stats/{statId} {
      allow read: if true;
      allow create, update: if isValidId(statId)
        && request.resource.data.totalMatches is number;
      allow delete: if false;
    }
  }
}
